# Local model weights already downloaded on the target server.
MODEL_PATH=/data/models/deepseek-v4.1-flash
# Override only with a mirror/digest of the exact default CUDA 13.0 v0.32.0 image.
BASE_IMAGE=vllm/vllm-openai:v0.32.0

# Dependencies are downloaded and SHA-256 verified during docker compose build.
# PyPI source for the eight ordinary dependency wheels: official, tuna, aliyun.
PYPI_MIRROR=official
# Optional PEP 503 index; a nonempty value overrides PYPI_MIRROR.
PYPI_INDEX_URL=
# Optional GitHub proxy prefix: PREFIX/https://github.com/...
GITHUB_PROXY_URL=
# Optional directory serving identical FlashInfer wheel filenames; overrides proxy.
KERNEL_WHEEL_BASE_URL=
