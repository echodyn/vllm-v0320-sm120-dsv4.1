+def _profile_indexer_logits_bytes(max_model_len, config, prefill_bytes, is_sm100):
+    """Peak logits reservation for the baseline's FP32 DeepGEMM API.
+
+    Later DeepGEMM versions emit BF16 on SM100; do not use that accounting
+    with the unchanged 1e1842a extension in the v0.32.0 image.
+    """
+    rows = 0
+    if config is not None:
+        scheduler = config.scheduler_config
+        rows = min(scheduler.max_num_seqs * (1 + config.num_speculative_tokens),
+                   scheduler.max_num_batched_tokens)
+    row_align = math.lcm(384 if is_sm100 else 256, 1024 // 4)
+    return max(prefill_bytes, rows * round_up(max_model_len, row_align) * 4)
 
 
